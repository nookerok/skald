{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skald.local/canon/anchor.schema.json",
  "title": "CanonicalAnchors",
  "description": "Registry of Canonical Anchors — the contract between Canon, Compiler and Region (WORLD_BIBLE_ARCHITECTURE.md §3.1). Anchors are the only permitted named instances in Canon (exception to A2) and must stay few; adding one is an ADR candidate.",
  "type": "object",
  "required": ["schemaVersion", "anchors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "conceptId", "regionId", "obligation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9_.-]+$" },
          "conceptId": {
            "type": "string",
            "minLength": 1,
            "description": "Must reference an existing Concept with lifecycle Canon."
          },
          "regionId": { "type": "string", "minLength": 1 },
          "obligation": { "enum": ["required"] },
          "provenance": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "source": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
