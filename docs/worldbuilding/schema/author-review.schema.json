{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SKALD Author Review",
  "type": "object",
  "required": [
    "schemaVersion",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "review": {
      "type": "object",
      "required": [
        "id",
        "proposalId",
        "reviewer",
        "reviewedAt",
        "decisions"
      ],
      "properties": {
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "proposalId",
              "decision"
            ],
            "properties": {
              "proposalId": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "enum": [
                  "accept",
                  "reject",
                  "defer"
                ]
              },
              "acceptedAs": {
                "type": "object",
                "required": [
                  "conceptId",
                  "factId"
                ],
                "properties": {
                  "conceptId": {
                    "type": "string"
                  },
                  "factId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
