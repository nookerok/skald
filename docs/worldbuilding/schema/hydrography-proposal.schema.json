{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SKALD Hydrography Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "proposal"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "proposal": {
      "type": "object",
      "required": [
        "id",
        "regionId",
        "sourceArtifact",
        "status",
        "waterBodies",
        "watercourses",
        "wetlands",
        "catchments"
      ],
      "properties": {
        "status": {
          "const": "proposed"
        },
        "waterBodies": {
          "type": "array"
        },
        "watercourses": {
          "type": "array"
        },
        "wetlands": {
          "type": "array"
        },
        "catchments": {
          "type": "array"
        }
      }
    }
  }
}
