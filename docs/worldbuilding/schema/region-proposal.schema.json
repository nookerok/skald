{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SKALD Region Proposal",
  "type": "object",
  "required": [
    "schemaVersion",
    "proposal"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "proposal": {
      "type": "object",
      "required": [
        "id",
        "regionId",
        "sourceArtifact",
        "status",
        "features",
        "toponyms",
        "hypotheses",
        "simulationCandidates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "regionId": {
          "type": "string",
          "minLength": 1
        },
        "sourceArtifact": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "experimental",
            "proposed"
          ]
        },
        "features": {
          "type": "array"
        },
        "toponyms": {
          "type": "array"
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement",
              "evidenceRefs",
              "categories",
              "confirmationPaths",
              "falsificationPaths",
              "confidence",
              "notCanonTruth",
              "status"
            ],
            "properties": {
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "notCanonTruth": {
                "const": true
              },
              "status": {
                "const": "proposed"
              },
              "categories": {
                "type": "array",
                "minItems": 1
              },
              "confirmationPaths": {
                "type": "array",
                "minItems": 1
              },
              "falsificationPaths": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        "simulationCandidates": {
          "type": "array"
        }
      }
    }
  }
}
