[Unit]
Description=Skald Living World Server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=nooker
WorkingDirectory=/home/nooker/skald

Environment=NODE_ENV=production
Environment=SKALD_HOST=0.0.0.0
Environment=SKALD_PORT=3000
Environment=SKALD_DB_PATH=/home/nooker/skald-data/events.sqlite
Environment=PATH=/home/nooker/.nvm/versions/node/v22.23.1/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

EnvironmentFile=-/home/nooker/skald-data/skald.env

ExecStartPre=/usr/bin/test -r /home/nooker/skald/package.json
ExecStartPre=/usr/bin/test -d /home/nooker/skald-data
ExecStartPre=/usr/bin/test -w /home/nooker/skald-data
ExecStart=/home/nooker/.nvm/versions/node/v22.23.1/bin/node --import tsx packages/cli/src/server.ts

Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The opencode_run narrative transport spawns the OpenCode CLI, which keeps
# session state under ~/.local/share/opencode, a model cache under
# ~/.cache/opencode, lock/state files under ~/.local/state/opencode and its
# config under ~/.config/opencode. HOME stays read-only; exactly these state
# directories are additionally writable.
ReadWritePaths=/home/nooker/skald-data /home/nooker/.local/share/opencode /home/nooker/.cache/opencode /home/nooker/.local/state/opencode /home/nooker/.config/opencode

StandardOutput=journal
StandardError=journal
SyslogIdentifier=skald

[Install]
WantedBy=multi-user.target
