# OpenCode Zen is the production model source. With SKALD_AI_REQUIRED=1 the
# deployment gate fetches its live catalogue and requires two probe-valid
# preferred models for both interpret and narrate.
SKALD_OPENCODE_ZEN_API_KEY=
# Optional legacy provider key; not used by live Zen catalogue selection.
SKALD_OLLAMA_CLOUD_API_KEY=
# Optional last-resort provider key (sk-or-v1-...); probed only when Zen and
# Ollama Cloud both activate nothing. Free quota is 20 req/min and 50 req/day
# account-wide, so this rung stays idle while earlier providers work.
SKALD_OPENROUTER_API_KEY=
SKALD_AI_REQUIRED=0
# Region used for free-model availability screening. OpenCode's catalogue is
# global; some free models are unavailable from the Orange Pi's region.
SKALD_OPENCODE_REGION=RU

# Local-subprocess OpenCode transport (off by default). The isolated daily
# free-model survey also requires this explicit opt-in. When enabled, a
# keyless `opencode_run` candidate is appended last on the narrate route only;
# actual narration fallback remains separately disabled unless opted in.
# Requires the containment `narrative` agent on the host and an absolute
# binary path when `opencode` is not on the service PATH (systemd units usually
# need it).
# SKALD_OPENCODE_RUN=1
# SKALD_OPENCODE_BIN=/home/nooker/.opencode/bin/opencode
# Set 2 only with an independently verified OpenCode 2 binary. V2 uses a
# private --standalone server and denies all tool actions in isolated config.
# SKALD_OPENCODE_CLI_MAJOR=2
# Optional overrides (defaults shown):
# SKALD_OPENCODE_RUN_AGENT=narrative
# SKALD_OPENCODE_RUN_MODEL=opencode/muse-spark-1.3-contributor-free
# Agent manifest source copied into the isolated home (default: the
# repo-pinned manifest installed by deploy):
# SKALD_OPENCODE_AGENT_MANIFEST=packages/cli/deploy/opencode-narrative-agent.md
# Set to 0 to run with the process HOME (debugging only, never production):
# SKALD_OPENCODE_ISOLATE_HOME=1

# Env syntax follows the systemd subset: plain KEY=value lines (quoted
# values honored, duplicate keys and malformed lines fail the deploy).
# Inline # comments are NOT stripped — keep lines clean. With the transport
# enabled, ISOLATE_HOME=0 and manifest overrides are refused in production.

# Usually empty for same-origin web UI
SKALD_CORS_ORIGIN=
