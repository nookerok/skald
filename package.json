{
  "name": "skald",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/event-bus",
    "packages/intent-parser",
    "packages/rule-engine",
    "packages/world",
    "packages/cli"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "bash scripts/validate.sh",
    "start:repl": "node --import tsx packages/cli/src/repl.ts",
    "start:server": "node --import tsx packages/cli/src/server.ts",
    "start": "npm run start:server"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
